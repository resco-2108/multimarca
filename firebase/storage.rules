rules_version = '2';

// ============================================================
//  Multimarca — Reglas de Storage
//  Las fotos de producto se ven públicamente; las sube solo el admin.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /products/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
